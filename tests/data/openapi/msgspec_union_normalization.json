{
  "openapi": "3.1.0",
  "info": {
    "title": "repro",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ]
          },
          "offset": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "minLength": 1
              },
              {
                "type": "string",
                "maxLength": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "device_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "DeviceType": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DeviceTypeList": {
        "type": "object",
        "required": [
          "device_types"
        ],
        "properties": {
          "device_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceType"
            }
          }
        }
      }
    }
  }
}
